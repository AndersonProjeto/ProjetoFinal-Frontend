# Copie para .env e ajuste conforme o ambiente.
#
# URL base da API, com o sufixo /api. Se esta variavel nao existir no momento do
# build, o bundle sai apontando para http://localhost:5121/api (ver
# src/client/client.jsx) — e o site publicado nao conversa com backend nenhum.
#
# Local:      http://localhost:5121/api
# Producao:   https://<seu-app>.up.railway.app/api
#
# Na Vercel, cadastrar em Settings > Environment Variables. O Vite le VITE_* no
# build, nao em tempo de execucao: mudar o valor exige um novo deploy.
VITE_API_URL=http://localhost:5121/api
